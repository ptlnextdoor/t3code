{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm --filter*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(sqlite3:*)",
      "Bash(node --test*)"
    ],
    "deny": ["Bash(rm -rf*)", "Read(./**/.env)", "Read(./**/*.pem)", "Read(./**/secrets/**)"]
  },
  "env": {
    "SUPERAPP": "t3code-shell+jcode-engine+grokbot-router+today-panel"
  }
}
